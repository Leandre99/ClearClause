# Copy this file to .env.local and fill in ONE of the options below.
# With no key at all, the app runs in demo mode (pre-written sample result).

# Option A (free): any OpenAI-compatible provider. Default is Google Gemini;
# get a free key at https://aistudio.google.com
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
#
# Groq instead (free tier, https://console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Option B (paid): Anthropic Claude API. Used only if LLM_API_KEY is empty.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
